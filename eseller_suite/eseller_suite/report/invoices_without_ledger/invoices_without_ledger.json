 "query": "SELECT\n    si.name,\n    si.posting_date,\n    si.grand_total\nFROM\n    `tabSales Invoice` si\nLEFT JOIN\n    `tabGL Entry` gle\n    ON gle.voucher_type = 'Sales Invoice'\n    AND gle.voucher_no = si.name\nWHERE\n    si.docstatus = 1\n    AND gle.name IS NULL\nORDER BY\n    si.posting_date DESC;",
